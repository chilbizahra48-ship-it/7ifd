# 7ifd Environment Variables
# ----------------------------------------------------
# Offline-First Architecture Notice:
# This project operates 100% offline-first using bundled CEFR datasets
# and local IndexedDB storage. No paid cloud AI key or direct cloud
# dependencies are mandatory to run the application.

# [OPTIONAL] GEMINI_API_KEY:
# Disabled by default. If you wish to enable Google Gemini AI features in the future:
# 1. Provide your key below (or as VITE_GEMINI_API_KEY).
# 2. Set VITE_ENABLE_AI="true" or toggle ENABLE_AI_FEATURES in src/lib/ai/gemini.ts.
# GEMINI_API_KEY="YOUR_OPTIONAL_GEMINI_API_KEY"
# VITE_ENABLE_AI="false"

# [OPTIONAL] Base URL (for GitHub Pages or custom hosting):
# Defaults to '/7ifd/' for production build (GitHub Pages), and '/' in local development.
# VITE_BASE_PATH="/7ifd/"

# APP_URL: Injected automatically in AI Studio / Cloud Run environments.
APP_URL="MY_APP_URL"
